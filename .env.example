# Hugging Face access token, used by pipeline/qa_engine.py to call the
# meta-llama/Meta-Llama-3-8B-Instruct model via the Hugging Face
# Inference API.
#
# 1. Create a token at https://huggingface.co/settings/tokens
# 2. Accept the model license at
#    https://huggingface.co/meta-llama/Meta-Llama-3-8B-Instruct
# 3. Copy this file to ".env" and paste your token below.

HF_TOKEN=your_huggingface_token_here
